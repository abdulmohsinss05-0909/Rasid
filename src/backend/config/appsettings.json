{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Hangfire": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Monitoring": {
    "AllowSampleData": false,
    "HighPriorityRefreshMinutes": 10,
    "NormalPriorityRefreshMinutes": 15,
    "LowPriorityRefreshMinutes": 60,
    "ContentRetentionDays": 30,
    "SnapshotRetentionDays": 30,
    "AggregateRetentionDays": 400,
    "MaxQueryLength": 512,
    "PageSize": 100,
    "DashboardCacheSeconds": 60,
    "ManualRefreshCooldownSeconds": 60,
    "Engagement": {
      "MediumFromPercent": 1,
      "HighAbovePercent": 3
    },
    "Quota": {
      "MonthlyPostReadBudget": 0,
      "ThrottleAtPercent": 80,
      "CriticalAtPercent": 95,
      "MaxPagesPerRun": 3
    },
    "MetricRefresh": {
      "FreshPostMinutes": 15,
      "RecentPostMinutes": 120,
      "OlderPostMinutes": 1440,
      "MaxPostsPerRun": 500
    }
  },
  "XApi": {
    "AttemptTimeoutSeconds": 20,
    "TotalTimeoutSeconds": 60,
    "MaxRetries": 2,
    "CursorMaxAgeDays": 6,
    "PostFieldsParameter": "tweet.fields",
    "PostFields": "created_at,public_metrics,author_id,lang,attachments,note_tweet",
    "Expansions": "author_id,attachments.media_keys",
    "UserFields": "name,username,profile_image_url,verified",
    "MediaFields": "type,url,preview_image_url,alt_text"
  },
  "Jwt": {
    "Issuer": "rasid",
    "Audience": "rasid-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Seed": {
    "ApplyMigrations": false,
    "CreateSampleTopic": false
  },
  "Worker": {
    "WorkerCount": 4
  }
}
