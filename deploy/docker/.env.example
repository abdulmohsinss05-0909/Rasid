# Copy to .env and fill in. .env holds secrets and must never be shared or committed.

# Development (sample data allowed) or UAT. Production runs on the hosting platform, not this file.
RASID_ENVIRONMENT=Development

# Angular build for the web container: production | uat (match RASID_ENVIRONMENT=UAT with uat).
RASID_WEB_CONFIGURATION=production

# SQL Server 'sa' password for the local container (8+ chars, upper, lower, digit, symbol).
SQL_SA_PASSWORD=

# JWT signing key: 32+ random characters.
JWT_SIGNING_KEY=

# First administrator (created on start-up if missing). Password: 12+ chars, upper, lower, digit, symbol.
ADMIN_EMAIL=admin@rasid.local
ADMIN_PASSWORD=

# Optional: X API v2 App-Only bearer token. Leave empty to run on clearly labelled SAMPLE data.
X_BEARER_TOKEN=
